{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public or student builder profile for community members",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string", "description": "Builder display name or nickname" },
        "schoolName": { "type": "string", "description": "School or learning community name" },
        "gradeLevel": { "type": "string", "description": "Student grade level" },
        "primaryInterest": { "type": "string", "description": "Primary building interest" },
        "avatarUrl": { "type": "string", "description": "Optional avatar photo URL or preset ID" },
        "avatarColor": { "type": "string", "description": "Brand accent badge color" },
        "role": { "type": "string", "enum": ["member", "moderator", "admin"], "description": "Community role" },
        "status": { "type": "string", "enum": ["active", "suspended", "banned"], "description": "Account moderation status" },
        "accountType": { "type": "string", "enum": ["public", "student"], "description": "Account tier" },
        "publishingDisabled": { "type": "boolean", "description": "Whether public post publishing is disabled for this user" },
        "bookmarkedPostIds": { "type": "array", "description": "List of bookmarked publicPost IDs" },
        "acceptedGuidelines": { "type": "boolean", "description": "Whether the user agreed to community safety guidelines" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["uid", "displayName", "avatarColor", "role", "acceptedGuidelines", "createdAt"]
    },
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Private PII user details restricted to the owner",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "StudentAccessRequest": {
      "title": "StudentAccessRequest",
      "description": "Student verification application for private Student Hub access",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Applicant Firebase UID" },
        "fullName": { "type": "string", "description": "Student full name" },
        "email": { "type": "string", "format": "email", "description": "Authenticated Google email" },
        "schoolName": { "type": "string", "description": "School name" },
        "gradeLevel": { "type": "string", "description": "Current class or grade" },
        "programme": { "type": "string", "description": "Registered Jaystarbliss Studios programme" },
        "studentReference": { "type": "string", "description": "Optional student registration or reference number" },
        "confirmedDeclaration": { "type": "boolean", "description": "Applicant accuracy declaration" },
        "status": {
          "type": "string",
          "enum": ["not_requested", "pending", "approved", "rejected", "more_information_required", "suspended"]
        },
        "verifiedAgainstOfficialRecords": { "type": "boolean", "description": "Whether verified against official Jaystarbliss Studios student records" },
        "reviewedBy": { "type": "string", "description": "Reviewer admin UID" },
        "reviewedAt": { "type": "string", "format": "date-time", "description": "Review timestamp" },
        "publicStatusNote": { "type": "string", "description": "Status message visible to the applicant" },
        "emailNotificationStatus": { "type": "string", "enum": ["idle", "sent", "failed", "skipped"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "email", "schoolName", "gradeLevel", "programme", "confirmedDeclaration", "status", "createdAt", "updatedAt"]
    },
    "CommunityMembership": {
      "title": "CommunityMembership",
      "description": "Approved student membership record granting private Student Hub access",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "status": { "type": "string", "enum": ["approved", "suspended", "revoked"] },
        "approvedBy": { "type": "string" },
        "approvedAt": { "type": "string", "format": "date-time" },
        "programme": { "type": "string" },
        "schoolName": { "type": "string" },
        "gradeLevel": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "status", "approvedBy", "approvedAt", "updatedAt"]
    },
    "PublicPost": {
      "title": "PublicPost",
      "description": "Public community showcase post, game, website, tutorial, or announcement",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "body": { "type": "string" },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "tags": { "type": "array" },
        "media": { "type": "array" },
        "websiteUrl": { "type": "string" },
        "gameUrl": { "type": "string" },
        "githubUrl": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "authorColor": { "type": "string" },
        "authorRole": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "pending_review", "published", "hidden", "removed"] },
        "isFeatured": { "type": "boolean" },
        "reactionCounts": { "type": "object" },
        "totalReactions": { "type": "integer" },
        "commentCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "body", "categoryId", "categoryName", "authorId", "authorName", "status", "createdAt", "updatedAt"]
    },
    "PublicComment": {
      "title": "PublicComment",
      "description": "Comment or nested reply on a public post",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "postId": { "type": "string" },
        "parentCommentId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorColor": { "type": "string" },
        "text": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "removed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "postId", "authorId", "authorName", "text", "status", "createdAt"]
    },
    "PublicReaction": {
      "title": "PublicReaction",
      "description": "Authenticated user reactions on a public post",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "postId": { "type": "string" },
        "types": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "postId", "types", "updatedAt"]
    },
    "PublicCategory": {
      "title": "PublicCategory",
      "description": "Public community content category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "emoji": { "type": "string" },
        "order": { "type": "integer" },
        "isActive": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "slug", "emoji", "order", "isActive", "updatedAt"]
    },
    "Presence": {
      "title": "Presence",
      "description": "Real-time online presence and typing status in channels",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "avatarColor": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "activeChannelId": { "type": "string" },
        "isTyping": { "type": "boolean" },
        "lastSeen": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "activeChannelId", "isTyping", "lastSeen"]
    },
    "CommunitySettings": {
      "title": "CommunitySettings",
      "description": "Global community administration settings controlled by the Super Admin",
      "type": "object",
      "properties": {
        "cooldownSeconds": { "type": "integer" },
        "disableCooldown": { "type": "boolean" },
        "banLinks": { "type": "boolean" },
        "enableLinkPreviews": { "type": "boolean" },
        "globalChatLocked": { "type": "boolean" },
        "updatedBy": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["cooldownSeconds", "disableCooldown", "banLinks", "enableLinkPreviews", "globalChatLocked", "updatedBy", "updatedAt"]
    },
    "CommunityChannel": {
      "title": "CommunityChannel",
      "description": "Channel definition, moderator assignments, and per-channel member permissions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string", "enum": ["INFORMATION", "CREATOR SHOWCASES", "SOCIAL"] },
        "emoji": { "type": "string" },
        "description": { "type": "string" },
        "defaultCreationCategory": { "type": "string", "enum": ["game", "website", "video", "novel", "other"] },
        "isCustom": { "type": "boolean" },
        "isLocked": { "type": "boolean" },
        "banLinks": { "type": "boolean" },
        "enableLinkPreviews": { "type": "boolean" },
        "cooldownSeconds": { "type": "integer" },
        "allowMemberMessages": { "type": "boolean" },
        "allowMemberGroups": { "type": "boolean" },
        "allowMemberInvites": { "type": "boolean" },
        "moderatorIds": { "type": "array" },
        "kickedUserIds": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "name", "category", "emoji", "description", "isCustom", "isLocked",
        "banLinks", "enableLinkPreviews", "cooldownSeconds", "allowMemberMessages",
        "allowMemberGroups", "allowMemberInvites", "moderatorIds", "kickedUserIds", "updatedAt"
      ]
    },
    "CommunityGroup": {
      "title": "CommunityGroup",
      "description": "Sub-group or private room nested inside a community channel",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "channelId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "isPrivate": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "memberIds": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "channelId", "name", "description", "isPrivate", "createdBy", "memberIds", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Community message or creation link showcase in a channel or sub-group",
      "type": "object",
      "properties": {
        "channelId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "authorColor": { "type": "string" },
        "authorRole": { "type": "string" },
        "text": { "type": "string" },
        "hadProfanity": { "type": "boolean" },
        "replyToId": { "type": "string" },
        "replyToAuthor": { "type": "string" },
        "replyToColor": { "type": "string" },
        "replyToSnippet": { "type": "string" },
        "linkUrl": { "type": "string" },
        "linkTitle": { "type": "string" },
        "linkDescription": { "type": "string" },
        "linkCategory": { "type": "string" },
        "linkDomain": { "type": "string" },
        "coverImageUrl": { "type": "string" },
        "reactions": { "type": "object" },
        "threadCount": { "type": "integer" },
        "isEdited": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["channelId", "authorId", "authorName", "authorColor", "text", "threadCount", "createdAt"]
    },
    "ThreadReply": {
      "title": "ThreadReply",
      "description": "Reply inside a message discussion thread",
      "type": "object",
      "properties": {
        "messageId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorColor": { "type": "string" },
        "text": { "type": "string" },
        "isEdited": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["messageId", "authorId", "authorName", "authorColor", "text", "createdAt"]
    },
    "ModerationReport": {
      "title": "ModerationReport",
      "description": "User report for a community message or public post",
      "type": "object",
      "properties": {
        "messageId": { "type": "string" },
        "channelId": { "type": "string" },
        "reporterId": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "resolved"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["messageId", "channelId", "reporterId", "reason", "status", "createdAt"]
    },
    "CommunityChallenge": {
      "title": "CommunityChallenge",
      "description": "Administrator-managed community challenge for young builders",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "categoryId": { "type": "string" },
        "learnerGroup": { "type": "string" },
        "skillLevel": { "type": "string", "enum": ["All Levels", "Beginner", "Intermediate", "Advanced"] },
        "programme": { "type": "string" },
        "instructions": { "type": "string" },
        "resources": { "type": "array" },
        "startDate": { "type": "string" },
        "deadline": { "type": "string" },
        "challengeStatus": { "type": "string", "enum": ["upcoming", "active", "completed"] },
        "publishStatus": { "type": "string", "enum": ["draft", "published", "archived"] },
        "accentColor": { "type": "string" },
        "coverImageUrl": { "type": "string" },
        "featured": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "createdByName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "description", "category", "categoryId", "learnerGroup", "skillLevel", "instructions", "challengeStatus", "publishStatus", "createdBy", "createdAt", "updatedAt"]
    },
    "ShowcaseSubmission": {
      "title": "ShowcaseSubmission",
      "description": "Student creation submitted from private hub for public showcase curation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sourceMessageId": { "type": "string" },
        "channelId": { "type": "string" },
        "creatorId": { "type": "string" },
        "creatorName": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "linkUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "more_information_required"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "creatorId", "creatorName", "title", "linkUrl", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public and student builder profiles"
    },
    "/users_private/{userId}": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "Private user PII restricted to owner"
    },
    "/studentAccessRequests/{userId}": {
      "schema": { "$ref": "#/entities/StudentAccessRequest" },
      "description": "Student verification applications for private Student Hub access"
    },
    "/communityMemberships/{userId}": {
      "schema": { "$ref": "#/entities/CommunityMembership" },
      "description": "Approved student membership records"
    },
    "/publicPosts/{postId}": {
      "schema": { "$ref": "#/entities/PublicPost" },
      "description": "Public community posts, games, websites, tutorials, and announcements"
    },
    "/publicPosts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/PublicComment" },
      "description": "Comments and nested replies on public posts"
    },
    "/publicPosts/{postId}/reactions/{userId}": {
      "schema": { "$ref": "#/entities/PublicReaction" },
      "description": "UID-bound reactions on public posts"
    },
    "/publicCategories/{categoryId}": {
      "schema": { "$ref": "#/entities/PublicCategory" },
      "description": "Public community categories"
    },
    "/communityChallenges/{challengeId}": {
      "schema": { "$ref": "#/entities/CommunityChallenge" },
      "description": "Administrator-managed community challenges"
    },
    "/showcaseSubmissions/{submissionId}": {
      "schema": { "$ref": "#/entities/ShowcaseSubmission" },
      "description": "Private hub showcase submissions for admin curation"
    },
    "/presence/{userId}": {
      "schema": { "$ref": "#/entities/Presence" },
      "description": "Real-time online presence and typing indicators"
    },
    "/community_settings/{settingId}": {
      "schema": { "$ref": "#/entities/CommunitySettings" },
      "description": "Global community administration settings"
    },
    "/community_channels/{channelId}": {
      "schema": { "$ref": "#/entities/CommunityChannel" },
      "description": "Custom channels, channel moderator assignments, and per-channel permissions"
    },
    "/community_groups/{groupId}": {
      "schema": { "$ref": "#/entities/CommunityGroup" },
      "description": "Sub-groups and private rooms inside channels"
    },
    "/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Channel and sub-group chat messages and creation link showcases"
    },
    "/messages/{messageId}/threadReplies/{replyId}": {
      "schema": { "$ref": "#/entities/ThreadReply" },
      "description": "Thread replies for a specific message"
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/ModerationReport" },
      "description": "Community moderation reports"
    }
  }
}
