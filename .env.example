# ============================================================================
# BUILD BUDS — ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================================

# ----------------------------------------------------------------------------
# 1. FIREBASE CLIENT CONFIGURATION (Public Web SDK)
# Supports both FIREBASE_* and VITE_FIREBASE_* on Vercel; falls back to firebase-applet-config.json
# ----------------------------------------------------------------------------
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_APP_ID=""
FIREBASE_DATABASE_ID=""

# ----------------------------------------------------------------------------
# 2. FIREBASE ADMIN SERVER CONFIGURATION (Strictly Server-Only)
# IMPORTANT: Do NOT prefix with VITE_ or FIREBASE_ because vite.config.ts exposes
# envPrefix: ['VITE_', 'FIREBASE_'] to the client bundle.
# ----------------------------------------------------------------------------
FB_ADMIN_SERVICE_ACCOUNT_JSON=""

# ----------------------------------------------------------------------------
# 3. CLOUDINARY IMAGE HOSTING (Signed Upload Architecture)
# Public cloud name may optionally be exposed to client, but API key & secret
# MUST remain server-only for POST /api/cloudinary/signature and /api/cloudinary/delete.
# ----------------------------------------------------------------------------
VITE_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET="buildbuds-public-posts"
CLOUDINARY_UPLOAD_FOLDER="buildbuds/public-posts"

# ----------------------------------------------------------------------------
# 4. RESEND TRANSACTIONAL EMAIL NOTIFICATIONS (Server-Only)
# Used by /api/student-access/submit, /approve, /reject, and /notify
# ----------------------------------------------------------------------------
RESEND_API_KEY=""
BUILDBUDS_FROM_EMAIL="Build Buds <notifications@jaystarbliss.com>"
BUILDBUDS_APP_URL="https://buildbuds.vercel.app"

# ----------------------------------------------------------------------------
# 5. OPTIONAL OFFICIAL STUDENT PORTAL API BOUNDARY (Server-Only)
# Leave blank to use the built-in Manual Admin Verification workflow at /admin/student-access
# ----------------------------------------------------------------------------
JW_STUDIOS_PORTAL_VERIFY_URL=""
JW_STUDIOS_PORTAL_API_KEY=""

# ----------------------------------------------------------------------------
# 6. AI STUDIO / GENERAL RUNTIME
# ----------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="https://buildbuds.vercel.app"
