rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (
          request.auth.token.get('admin', false) == true ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
          (request.auth.token.email == "johnrufai242@gmail.com" &&
            request.auth.token.email_verified == true)
        );
    }

    function isNotRevokedMembership() {
      return !exists(/databases/$(database)/documents/communityMemberships/$(request.auth.uid)) ||
        !(get(/databases/$(database)/documents/communityMemberships/$(request.auth.uid)).data.get('status', 'approved') in ['revoked', 'suspended']);
    }

    function isGlobalModeratorUser() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'member') in ['moderator', 'admin'];
    }

    function isApprovedStudent() {
      return isAuthenticated() &&
        (
          isAdmin() ||
          (exists(/databases/$(database)/documents/communityMemberships/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/communityMemberships/$(request.auth.uid)).data.status == 'approved') ||
          (exists(/databases/$(database)/documents/studentAccessRequests/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/studentAccessRequests/$(request.auth.uid)).data.status == 'approved' &&
            isNotRevokedMembership()) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            isNotRevokedMembership() &&
            (
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'member') in ['moderator', 'admin'] ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isApprovedStudent', false) == true ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('studentAccessStatus', 'none') == 'approved' ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('accountType', 'public') == 'student'
            ))
        );
    }

    function isActiveUser() {
      return isAuthenticated() &&
        (
          isAdmin() ||
          !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') == 'active'
        );
    }

    function isNotBanned() {
      return isAuthenticated() &&
        (
          isAdmin() ||
          !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') != 'banned'
        );
    }

    function isPublishingEnabled() {
      return isAuthenticated() &&
        (
          isAdmin() ||
          !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('publishingDisabled', false) == false
        );
    }

    function isChannelModerator(channelId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/community_channels/$(channelId)) &&
        request.auth.uid in get(/databases/$(database)/documents/community_channels/$(channelId)).data.moderatorIds;
    }

    function isNotKickedFromChannel(channelId) {
      return isAdmin() ||
        !exists(/databases/$(database)/documents/community_channels/$(channelId)) ||
        !(request.auth.uid in get(/databases/$(database)/documents/community_channels/$(channelId)).data.kickedUserIds);
    }

    function isValidUserProfile(data, userId) {
      return data.uid is string && data.uid == userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        (!('schoolName' in data) || (data.schoolName is string && data.schoolName.size() <= 120)) &&
        (!('gradeLevel' in data) || (data.gradeLevel is string && data.gradeLevel.size() <= 50)) &&
        (!('primaryInterest' in data) || (data.primaryInterest is string && data.primaryInterest.size() <= 80)) &&
        (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 350000)) &&
        data.avatarColor is string && data.avatarColor.size() <= 30 &&
        data.role in ['member', 'moderator', 'admin'] &&
        (!('status' in data) || data.status in ['active', 'suspended', 'banned']) &&
        (!('acceptedGuidelines' in data) || data.acceptedGuidelines is bool) &&
        (!('createdAt' in data) || data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() <= 60));
    }

    function isValidMessage(data) {
      return data.channelId is string && data.channelId.size() >= 1 && data.channelId.size() <= 160 &&
        data.authorId is string && data.authorId == request.auth.uid &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100 &&
        (!('authorColor' in data) || (data.authorColor is string && data.authorColor.size() <= 40)) &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 4000 &&
        (!('threadCount' in data) || (data.threadCount is int && data.threadCount >= 0)) &&
        (!('createdAt' in data) || data.createdAt is timestamp || (data.createdAt is string && data.createdAt.size() <= 60)) &&
        (!('coverImageUrl' in data) || (data.coverImageUrl is string && data.coverImageUrl.size() <= 800000)) &&
        (!('linkUrl' in data) || (data.linkUrl is string && data.linkUrl.size() <= 2000));
    }

    // ===============================================================
    // Public Builder Profiles (/users/{userId})
    // ===============================================================
    match /users/{userId} {
      allow read: if true;

      allow create: if (isOwner(userId) &&
        isValidUserProfile(request.resource.data, userId) &&
        (!('status' in request.resource.data) || request.resource.data.status == 'active') &&
        (request.resource.data.role == 'member' || isAdmin())) ||
        isAdmin();

      allow update: if (isOwner(userId) &&
        (!('uid' in resource.data) || request.resource.data.uid == resource.data.uid) &&
        (!('role' in resource.data) || request.resource.data.role == resource.data.role || isAdmin()) &&
        request.resource.data.get('status', 'active') == resource.data.get('status', 'active') &&
        request.resource.data.get('publishingDisabled', false) == resource.data.get('publishingDisabled', false)) ||
        isAdmin();

      allow delete: if isAdmin();
    }

    // ===============================================================
    // Private User PII (/users_private/{userId})
    // ===============================================================
    match /users_private/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 160;
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Admins Registry (/admins/{adminUid})
    // ===============================================================
    match /admins/{adminUid} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ===============================================================
    // Student Access Requests (/studentAccessRequests/{userId})
    // ===============================================================
    match /studentAccessRequests/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if (isOwner(userId) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.fullName is string && request.resource.data.fullName.size() >= 1 && request.resource.data.fullName.size() <= 120 &&
        request.resource.data.email is string && request.resource.data.email.size() >= 3 && request.resource.data.email.size() <= 160 &&
        request.resource.data.schoolName is string && request.resource.data.schoolName.size() >= 1 && request.resource.data.schoolName.size() <= 160 &&
        request.resource.data.gradeLevel is string && request.resource.data.gradeLevel.size() >= 1 && request.resource.data.gradeLevel.size() <= 80 &&
        request.resource.data.programme is string && request.resource.data.programme.size() >= 1 && request.resource.data.programme.size() <= 160 &&
        request.resource.data.confirmedDeclaration == true &&
        request.resource.data.status == 'pending' &&
        request.resource.data.verifiedAgainstOfficialRecords == false) ||
        isAdmin();

      allow update: if (isOwner(userId) &&
        resource.data.status in ['not_requested', 'pending', 'rejected', 'more_information_required'] &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.confirmedDeclaration == true &&
        request.resource.data.status == 'pending' &&
        request.resource.data.verifiedAgainstOfficialRecords == false) ||
        isAdmin();

      allow delete: if isAdmin();
    }

    // ===============================================================
    // Private Admin Review Notes (/studentAccessAdminNotes/{userId})
    // ===============================================================
    match /studentAccessAdminNotes/{userId} {
      allow read, write: if isAdmin();
    }

    // ===============================================================
    // Approved Student Memberships (/communityMemberships/{userId})
    // ===============================================================
    match /communityMemberships/{userId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ===============================================================
    // In-App User Notifications (/userNotifications/{userId}/items/{notificationId})
    // Allows signed-in users to deliver mention, follow, comment, reaction, and moderation alerts
    // while restricting reads/updates/deletes strictly to the inbox owner or admins.
    // ===============================================================
    match /userNotifications/{userId}/items/{notificationId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) ||
        isAdmin() ||
        isGlobalModeratorUser() ||
        (isAuthenticated() &&
          isNotBanned() &&
          request.resource.data.uid == userId &&
          request.resource.data.read == false &&
          request.resource.data.type in [
            'mention',
            'followed_creator_post',
            'post_comment',
            'post_reaction',
            'new_follower',
            'post_pending_review',
            'moderation_report',
            'hub_message'
          ] &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.title is string && request.resource.data.title.size() <= 200 &&
          request.resource.data.message is string && request.resource.data.message.size() <= 1000);
      allow update: if (isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])) ||
        isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ===============================================================
    // Admin Audit Logs (/adminAuditLogs/{logId})
    // ===============================================================
    match /adminAuditLogs/{logId} {
      allow read, create: if isAdmin() || isGlobalModeratorUser();
      allow update, delete: if false;
    }

    // ===============================================================
    // Creator Follows (/creatorFollows/{followId})
    // ===============================================================
    match /creatorFollows/{followId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        isNotBanned() &&
        request.resource.data.followerUid == request.auth.uid &&
        request.resource.data.creatorUid is string &&
        request.resource.data.creatorUid.size() >= 1 &&
        request.resource.data.creatorUid != request.auth.uid &&
        followId == request.auth.uid + '_' + request.resource.data.creatorUid;
      allow delete: if isAuthenticated() &&
        resource.data.followerUid == request.auth.uid;
    }

    // ===============================================================
    // Hub Channel Unread & Mention Activity Summaries (/channelActivity/{channelId})
    // ===============================================================
    match /channelActivity/{channelId} {
      allow read: if isAuthenticated();
      allow create, update: if isApprovedStudent() &&
        isActiveUser() &&
        request.resource.data.channelId is string &&
        request.resource.data.lastMessageAuthorId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Public Community Posts (/publicPosts/{postId})
    // Only Verified & Approved Student Hub Members (isApprovedStudent) or Admins/Moderators can publish!
    // Non-admin/mod posts require Moderator approval (`pending_review` -> `published`).
    // ===============================================================
    match /publicPosts/{postId} {
      allow read: if resource.data.status == 'published' ||
        (isAuthenticated() && resource.data.authorId == request.auth.uid) ||
        isAdmin() ||
        isGlobalModeratorUser();

      allow create: if isAuthenticated() &&
        isNotBanned() &&
        isPublishingEnabled() &&
        (
          (isApprovedStudent() &&
            request.resource.data.authorId == request.auth.uid &&
            request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 200 &&
            request.resource.data.body is string && request.resource.data.body.size() >= 1 && request.resource.data.body.size() <= 20000 &&
            (request.resource.data.status in ['draft', 'pending_review'] ||
              (request.resource.data.status == 'published' && (isAdmin() || isGlobalModeratorUser()))) &&
            (request.resource.data.get('isFeatured', false) == false || isAdmin() || isGlobalModeratorUser())) ||
          // Allow first-time transaction initialization of official seed posts when reacting/commenting
          (postId.matches('^seed-.*') && request.resource.data.status == 'published') ||
          isAdmin()
        );

      allow update: if (isAuthenticated() &&
        isNotBanned() &&
        isApprovedStudent() &&
        resource.data.authorId == request.auth.uid &&
        request.resource.data.authorId == resource.data.authorId &&
        (request.resource.data.status in ['draft', 'pending_review'] ||
          (request.resource.data.status == 'published' && (isAdmin() || isGlobalModeratorUser()))) &&
        (request.resource.data.get('isFeatured', false) == resource.data.get('isFeatured', false) || isAdmin() || isGlobalModeratorUser())) ||
        // Allow Moderators & Admins to review, approve, hide, remove, or feature any post
        (isGlobalModeratorUser() &&
          request.resource.data.authorId == resource.data.authorId) ||
        // Allow authenticated users to update reactionCounts, totalReactions, commentCount, updatedAt
        (isAuthenticated() &&
          isNotBanned() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactionCounts', 'totalReactions', 'commentCount', 'updatedAt'])) ||
        isAdmin();

      allow delete: if (isAuthenticated() && isApprovedStudent() && resource.data.authorId == request.auth.uid) ||
        isAdmin() ||
        isGlobalModeratorUser();

      // Nested Public Comments (/publicPosts/{postId}/comments/{commentId})
      match /comments/{commentId} {
        allow read: if true;

        allow create: if isAuthenticated() &&
          isNotBanned() &&
          request.resource.data.postId == postId &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() >= 1 &&
          request.resource.data.text.size() <= 4000 &&
          request.resource.data.status == 'active';

        allow update: if (isAuthenticated() &&
          isNotBanned() &&
          resource.data.authorId == request.auth.uid &&
          request.resource.data.authorId == resource.data.authorId &&
          request.resource.data.postId == resource.data.postId &&
          request.resource.data.text is string &&
          request.resource.data.text.size() >= 1 &&
          request.resource.data.text.size() <= 4000) ||
          isAdmin();

        allow delete: if (isAuthenticated() && resource.data.authorId == request.auth.uid) || isAdmin();
      }

      // UID-Bound Public Reactions (/publicPosts/{postId}/reactions/{userId})
      match /reactions/{userId} {
        allow read: if true;

        allow create, update: if isOwner(userId) &&
          isNotBanned() &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.postId == postId &&
          request.resource.data.types is list &&
          request.resource.data.types.size() <= 10;

        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // ===============================================================
    // Public Community Categories (/publicCategories/{categoryId})
    // ===============================================================
    match /publicCategories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ===============================================================
    // Administrator-Managed Community Challenges (/communityChallenges/{challengeId})
    // ===============================================================
    match /communityChallenges/{challengeId} {
      allow read: if resource.data.publishStatus == 'published' || isAdmin();
      allow create, update: if isAdmin() &&
        request.resource.data.title is string &&
        request.resource.data.title.size() >= 1 &&
        request.resource.data.title.size() <= 200 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() >= 1 &&
        request.resource.data.description.size() <= 20000 &&
        request.resource.data.publishStatus in ['draft', 'published', 'archived'] &&
        request.resource.data.challengeStatus in ['upcoming', 'active', 'completed'];
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Showcase Submissions (/showcaseSubmissions/{submissionId})
    // ===============================================================
    match /showcaseSubmissions/{submissionId} {
      allow read: if (isAuthenticated() && resource.data.creatorId == request.auth.uid) || isAdmin();
      allow create: if isApprovedStudent() &&
        isNotBanned() &&
        request.resource.data.creatorId == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.title.size() >= 1 &&
        request.resource.data.title.size() <= 200 &&
        request.resource.data.linkUrl is string &&
        request.resource.data.linkUrl.size() <= 1000 &&
        request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // ===============================================================
    // Real-Time Presence & Typing (/presence/{userId}) — Student Hub Only
    // ===============================================================
    match /presence/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) &&
        isApprovedStudent() &&
        isNotBanned() &&
        request.resource.data.uid == userId &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() <= 80 &&
        request.resource.data.activeChannelId is string &&
        request.resource.data.activeChannelId.size() <= 120 &&
        request.resource.data.isTyping is bool &&
        (!('avatarUrl' in request.resource.data) || (request.resource.data.avatarUrl is string && request.resource.data.avatarUrl.size() <= 350000));
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ===============================================================
    // Global Community Settings (/community_settings/{settingId})
    // ===============================================================
    match /community_settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ===============================================================
    // Community Channels (/community_channels/{channelId})
    // ===============================================================
    match /community_channels/{channelId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isApprovedStudent() &&
          isChannelModerator(channelId) &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.moderatorIds == resource.data.moderatorIds);
    }

    // ===============================================================
    // Channel Sub-Groups & Private Rooms (/community_groups/{groupId})
    // ===============================================================
    match /community_groups/{groupId} {
      allow read: if isAuthenticated() &&
        (
          !resource.data.isPrivate ||
          request.auth.uid in resource.data.memberIds ||
          isAdmin()
        );

      allow create: if isApprovedStudent() &&
        isActiveUser() &&
        isNotKickedFromChannel(request.resource.data.channelId) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 1 &&
        request.resource.data.name.size() <= 80 &&
        request.resource.data.memberIds is list;

      allow update: if isApprovedStudent() &&
        isActiveUser() &&
        (
          isAdmin() ||
          isChannelModerator(resource.data.channelId) ||
          resource.data.createdBy == request.auth.uid ||
          request.auth.uid in resource.data.memberIds
        );

      allow delete: if isAdmin() ||
        (isApprovedStudent() && isChannelModerator(resource.data.channelId)) ||
        (isApprovedStudent() && resource.data.createdBy == request.auth.uid);
    }

    // ===============================================================
    // Private Student Hub Chat Messages (/messages/{messageId})
    // ===============================================================
    match /messages/{messageId} {
      allow read: if (isApprovedStudent() && isActiveUser() && isNotBanned()) ||
        isAdmin() ||
        isChannelModerator(resource.data.channelId) ||
        isGlobalModeratorUser();

      allow create: if (isApprovedStudent() &&
        isActiveUser() &&
        isValidMessage(request.resource.data)) ||
        isAdmin();

      allow update: if isApprovedStudent() &&
        isActiveUser() &&
        request.resource.data.authorId == resource.data.authorId &&
        request.resource.data.channelId == resource.data.channelId &&
        (
          (request.resource.data.text == resource.data.text &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'reactions',
              'userReactions',
              'threadCount',
              'updatedAt',
              'showcaseStatus',
              'showcaseRequestedAt',
              'publicPostId',
              'linkUrl',
              'linkTitle',
              'linkDescription',
              'linkCategory',
              'linkDomain',
              'coverImageUrl'
            ])) ||
          (resource.data.authorId == request.auth.uid &&
            request.resource.data.text is string &&
            request.resource.data.text.size() >= 1 &&
            request.resource.data.text.size() <= 4000 &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'text',
              'isEdited',
              'updatedAt',
              'hadProfanity',
              'linkUrl',
              'linkTitle',
              'linkDescription',
              'linkCategory',
              'linkDomain',
              'coverImageUrl'
            ])) ||
          ((isAdmin() || isChannelModerator(resource.data.channelId) || isGlobalModeratorUser()) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'isPinned',
              'pinnedAtMillis',
              'pinnedBy',
              'updatedAt'
            ])) ||
          isAdmin() ||
          isChannelModerator(resource.data.channelId) ||
          isGlobalModeratorUser()
        );

      allow delete: if isApprovedStudent() &&
        (resource.data.authorId == request.auth.uid ||
          isAdmin() ||
          isChannelModerator(resource.data.channelId) ||
          isGlobalModeratorUser());

      // Nested Thread Replies
      match /threadReplies/{replyId} {
        allow read: if (isApprovedStudent() && isActiveUser() && isNotBanned()) ||
          isAdmin() ||
          isGlobalModeratorUser();

        allow create: if isApprovedStudent() &&
          isActiveUser() &&
          request.resource.data.messageId == messageId &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.authorName is string &&
          request.resource.data.authorName.size() >= 1 &&
          request.resource.data.authorName.size() <= 100 &&
          request.resource.data.text is string &&
          request.resource.data.text.size() >= 1 &&
          request.resource.data.text.size() <= 2500 &&
          (!('createdAt' in request.resource.data) ||
            request.resource.data.createdAt is timestamp ||
            (request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 60));

        allow update: if isApprovedStudent() &&
          isActiveUser() &&
          resource.data.authorId == request.auth.uid &&
          request.resource.data.authorId == resource.data.authorId &&
          request.resource.data.messageId == resource.data.messageId &&
          request.resource.data.text is string &&
          request.resource.data.text.size() >= 1 &&
          request.resource.data.text.size() <= 2500 &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'isEdited', 'updatedAt']);

        allow delete: if isApprovedStudent() &&
          (resource.data.authorId == request.auth.uid || isAdmin());
      }
    }

    // ===============================================================
    // Moderation Reports (/reports/{reportId})
    // ===============================================================
    match /reports/{reportId} {
      allow read: if isAdmin() ||
        isGlobalModeratorUser() ||
        isChannelModerator(resource.data.channelId);
      allow create: if isAuthenticated() &&
        isNotBanned() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.messageId is string &&
        request.resource.data.channelId is string &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() >= 1 &&
        request.resource.data.reason.size() <= 500 &&
        request.resource.data.status == 'open';
      allow update, delete: if isAdmin() ||
        isGlobalModeratorUser() ||
        isChannelModerator(resource.data.channelId);
    }
  }
}
